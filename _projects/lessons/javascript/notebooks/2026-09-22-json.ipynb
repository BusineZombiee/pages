"## Homework Hack: JSON Character Sheet\n",
"\n",
"Create a character sheet using a JavaScript object.\n",
"\n",
"Your character sheet must contain:\n",
"- `name`\n",
"- `username`\n",
"- `character_info`\n",
"  - `level`\n",
"  - `class`\n",
"  - `health`\n",
"- `skills`\n",
"\n",
"Then:\n",
"1. Access and display the properties.\n",
"2. Convert the object into a JSON string.\n",
"3. Print the JSON string.\n",
"4. Parse the JSON string back into an object.\n",
"5. Print the parsed object."
]
},
{
"cell_type": "code",
"execution_count": null,
"id": "b83e16f4",
"metadata": {
"vscode": {
"languageId": "javascript"
}
},
"outputs": [],
"source": [
"%%js\n",
"\n",
"// CODE_RUNNER: Homework - Create a character sheet and convert it to JSON.\n",
"\n",
"// 1. Create your JavaScript object.\n",
"const character_sheet = {\n",
"    name: "",\n",
"    username: "",\n",
"    character_info: {\n",
"        level: "",\n",
"        class: "",\n",
"        health: ""\n",
"    },\n",
"    skills: []\n",
"};\n",
"\n",
"// 2. Access and display properties.\n",
"console.log("Name:", character_sheet.name);\n",
"console.log("Username:", character_sheet.username);\n",
"console.log("Level:", character_sheet.character_info.level);\n",
"console.log("Class:", character_sheet.character_info.class);\n",
"console.log("Health:", character_sheet.character_info.health);\n",
"console.log("Skills:", character_sheet.skills);\n",
"\n",
"// 3. Convert the JavaScript object into a JSON string.\n",
"const jsonString = JSON.stringify(character_sheet);\n",
"\n",
"console.log("JSON string:");\n",
"console.log(jsonString);\n",
"\n",
"// 4. Parse the JSON string back into a JavaScript object.\n",
"const parsedCharacterSheet = JSON.parse(jsonString);\n",
"\n",
"console.log("Parsed character sheet:");\n",
"console.log(parsedCharacterSheet);"
]
},
