"1": {
"title": "LxD Cycle Process",
"empathize": "Beginners often confuse JavaScript objects with JSON because the two look very similar. Students may forget that JSON has stricter rules than JavaScript objects.",
"define": {
"pov": "JavaScript students need to understand the difference between JavaScript objects and JSON because both use key-value structures, but JSON follows stricter rules and is primarily used to store and transfer data.",
"learning_goal": "Students will create JavaScript objects, access and modify object properties, understand JSON syntax rules, convert JavaScript objects to JSON strings, and parse JSON strings back into JavaScript objects."
},
"ideate": {
"hmw_questions": [
"How might we help students recognize the difference between a JavaScript object and JSON?",
"How might we make JSON useful and understandable by connecting it to something familiar, such as a game character?"
],
"activities": [
"Create and personalize a game-character object.",
"Access object properties using dot notation.",
"Identify valid and invalid JSON.",
"Convert JavaScript objects into JSON strings.",
"Parse JSON strings back into JavaScript objects.",
"Build a personalized character sheet."
]
},
"prototype_and_test": "Lesson authors: Add what happened during the trial run and what changes were made based on student or peer feedback."
},

"2": {
  "title": "Lesson Plan",
  "learning_objective": "Students will understand how JavaScript objects store key-value data and how JSON is used to store and transfer structured data.",
  "success_criteria": [
    "Create an object using key-value pairs.",
    "Access a property using dot notation.",
    "Explain the difference between JavaScript objects and JSON.",
    "Identify basic JSON syntax rules.",
    "Use JSON.stringify() to create a JSON string.",
    "Use JSON.parse() to turn JSON into a JavaScript object.",
    "Create a nested object containing an array."
  ],
  "tech_talk": {
    "duration_minutes": 5,
    "content": "A JavaScript object stores related information using key-value pairs. JSON looks similar to a JavaScript object, but JSON is a text format for storing and transferring data.",
    "key_points": [
      "JavaScript objects use key-value pairs.",
      "JSON is a text format.",
      "JSON requires double quotes around keys.",
      "JSON does not allow functions.",
      "JSON does not allow comments.",
      "JSON does not allow trailing commas.",
      "JSON.stringify() converts an object into JSON.",
      "JSON.parse() converts JSON into a JavaScript object."
    ]
  }
},

"3": {
  "title": "Reference Guide",
  "key_vocabulary": {
    "Object": "A JavaScript structure containing key-value pairs.",
    "Key": "The name of a property.",
    "Value": "The information stored under a key.",
    "Property": "A key-value pair in an object.",
    "Nested Object": "An object stored inside another object.",
    "Array": "An ordered list of values.",
    "JSON": "A text format used to store and transfer structured data.",
    "JSON.stringify()": "Converts a JavaScript object into a JSON string.",
    "JSON.parse()": "Converts a JSON string into a JavaScript object.",
    "Undefined": "The value returned when a property does not exist."
  },
  "object_example": {
    "name": "Steve",
    "level": 10,
    "class": "Warrior"
  },
  "json_rules": [
    "Keys require double quotes.",
    "Strings require double quotes.",
    "Functions are not allowed.",
    "Comments are not allowed.",
    "Trailing commas are not allowed."
  ]
},

"4": {
  "title": "Code Examples",
  "examples": [
    {
      "title": "Simple JavaScript Object",
      "code": "const student = {\n    name: \"Steve\",\n    level: 10,\n    class: \"Warrior\"\n};\n\nconsole.log(student);"
    },
    {
      "title": "Access Object Properties",
      "code": "const character = {\n    name: \"Steve\",\n    level: 10,\n    class: \"Warrior\"\n};\n\nconsole.log(\"Name:\", character.name);\nconsole.log(\"Level:\", character.level);\nconsole.log(\"Class:\", character.class);"
    },
    {
      "title": "Parse JSON",
      "code": "const jsonData = `\n{\n    \"name\": \"Steve\",\n    \"level\": 10,\n    \"class\": \"Warrior\",\n    \"online\": true\n}\n`;\n\nconst parsedData = JSON.parse(jsonData);\nconsole.log(parsedData);"
    },
    {
      "title": "Convert Between Object and JSON",
      "code": "const user = {\n    username: \"PLAYER_1\",\n    password: 12345,\n    isOnline: false\n};\n\nconst jsonString = JSON.stringify(user);\nconsole.log(jsonString);\n\nconst parsedUser = JSON.parse(jsonString);\nconsole.log(parsedUser);"
    },
    {
      "title": "Nested Character Object",
      "code": "const character = {\n    name: \"Steve\",\n    username: \"PLAYER_1\",\n    character_info: {\n        level: 10,\n        class: \"Warrior\",\n        health: 100\n    },\n    skills: [\"Attack\", \"Defend\", \"Heal\"]\n};\n\nconsole.log(character);"
    }
  ]
},

